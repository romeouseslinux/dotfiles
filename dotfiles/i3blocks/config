# Global settings
command=/usr/libexec/i3blocks/$BLOCK_NAME
separator_block_width=20
markup=none

[cpu]
label=CPU 
command=top -bn1 | grep "CPU:" | head -n1 | awk '{print $2}'
interval=3
color=#88c0d0

[memory]
label=RAM 
command=free -h | awk '/Mem:/ { print $3 "/" $2 }'
interval=5
color=#a3be8c

[battery]
label=BAT 
command=cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | awk '{print $1"%"}' || echo "N/A"
interval=10
color=#ebcb8b

[time]
label=
command=date '+%Y-%m-%d  %H:%M:%S'
interval=1
color=#eceff4
