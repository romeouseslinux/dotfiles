{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {"logo": {
      "source": "$HOME/.config/fastfetch/logo.txt"
  }
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    {
      "type": "command",
      "key": "Memory",
      "text": "free -h | awk '/Mem:/ {print $3 \" / \" $2 \" (available: \" $7 \")\"}'"
    },
    "break",
    "colors"
  ]
}
